---
import type { Project } from '../data/profile';
import { linkAttrs } from '../utils/links';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class="card" id={project.slug} aria-labelledby={`${project.slug}-title`}>
	<div class="head">
		<h3 id={`${project.slug}-title`}>{project.name}</h3>
		<p class="when muted">{project.when}</p>
	</div>
	<p class="summary">{project.summary}</p>
	<ul class="points">
		{project.highlights.map((point) => <li>{point}</li>)}
	</ul>
	<h4 class="visually-hidden">Built with</h4>
	<ul class="tags">
		{project.stack.map((tech) => <li>{tech}</li>)}
	</ul>
	{
		project.links.length > 0 && (
			<p class="links">
				{project.links.map((link) => (
					<a {...linkAttrs(link.href)}>
						View {link.label.toLowerCase()}
						<span class="visually-hidden">
							for {project.name} (opens in a new tab)
						</span>
					</a>
				))}
			</p>
		)
	}
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}

	h3 {
		font-size: 1.2rem;
		font-weight: 650;
	}

	.when {
		font-size: 0.9rem;
	}

	.summary {
		color: var(--text);
	}

	.links {
		margin-top: auto;
		padding-top: 0.25rem;
		font-weight: 600;
		font-size: 0.95rem;
	}
</style>
