---
import type { Project } from '../data/profile';
import { linkAttrs } from '../utils/links';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class="card" id={project.slug} aria-labelledby={`${project.slug}-title`}>
	<header>
		<h3 id={`${project.slug}-title`}>{project.name}</h3>
		<p class="when muted">{project.when}</p>
	</header>
	<p>{project.summary}</p>
	<ul class="highlights">
		{project.highlights.map((point) => <li>{point}</li>)}
	</ul>
	<h4 class="visually-hidden">Built with</h4>
	<ul class="chips">
		{project.stack.map((tech) => <li>{tech}</li>)}
	</ul>
	{
		project.links.length > 0 && (
			<p class="links">
				{project.links.map((link) => (
					<a {...linkAttrs(link.href)}>
						{link.label}
						<span class="visually-hidden">
							for {project.name} (opens in a new tab)
						</span>
						<span aria-hidden="true"> ↗</span>
					</a>
				))}
			</p>
		)
	}
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 150ms ease;
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--accent);
	}

	header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}

	h3 {
		font-size: 1.05rem;
		color: var(--text);
	}

	h3::before {
		content: '> ';
		color: var(--accent);
	}

	.when {
		font-size: 0.85rem;
	}

	.highlights li {
		position: relative;
		padding-left: 1.5ch;
		font-size: 0.925rem;
	}

	.highlights li::before {
		content: '-';
		position: absolute;
		left: 0;
		color: var(--muted);
	}

	.links {
		margin-top: auto;
		display: flex;
		gap: 1rem;
	}
</style>
