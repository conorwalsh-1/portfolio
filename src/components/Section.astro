---
interface Props {
	id: string;
	title: string;
	/** Optional one-line introduction under the heading. */
	intro?: string;
}

const { id, title, intro } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="section">
	<div class="container">
		<header>
			<h2 id={`${id}-heading`}>{title}</h2>
			{intro && <p class="intro muted">{intro}</p>}
		</header>
		<slot />
	</div>
</section>

<style>
	.section {
		padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
		border-top: 1px solid var(--border);
	}

	header {
		margin-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
	}

	h2 {
		font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
		font-weight: 700;
	}

	.intro {
		margin-top: 0.5rem;
		max-width: var(--measure);
	}
</style>
