---
/**
 * A page section headed like a shell command, e.g. `$ ls ./projects`.
 * The command is decorative; screen readers hear only the section name.
 */
interface Props {
	id: string;
	command: string;
	label: string;
	suffix?: string;
}

const { id, command, label, suffix = '' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="section container">
	<h2 id={`${id}-heading`}>
		<span class="prompt" aria-hidden="true">$</span>
		<span class="command" aria-hidden="true">{command}</span>
		<span class="label">{label}</span><span class="command" aria-hidden="true">{suffix}</span>
	</h2>
	<div class="body">
		<slot />
	</div>
</section>

<style>
	.section {
		padding-top: clamp(3rem, 2rem + 4vw, 5rem);
	}

	h2 {
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
		margin-bottom: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.6ch;
	}

	.prompt {
		color: var(--prompt);
	}

	.command {
		color: var(--muted);
		font-weight: 400;
	}

	.label {
		color: var(--accent);
	}

	.label + .command {
		margin-left: -0.6ch;
	}
</style>
