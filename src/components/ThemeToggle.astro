<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
	<svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
		></path>
	</svg>
	<svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	</svg>
</button>

<script>
	type Theme = 'light' | 'dark';

	const root = document.documentElement;
	const media = window.matchMedia('(prefers-color-scheme: dark)');

	function current(): Theme {
		const set = root.dataset.theme;
		if (set === 'light' || set === 'dark') return set;
		return media.matches ? 'dark' : 'light';
	}

	function render() {
		const next = current() === 'dark' ? 'light' : 'dark';
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			button.setAttribute('aria-label', `Switch to ${next} theme`);
		}
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => {
			const next: Theme = current() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				/* storage blocked: the choice lasts for this page view only */
			}
			render();
		});
	}

	media.addEventListener('change', render);
	render();
</script>

<style>
	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		color: var(--muted);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 999px;
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--text);
		border-color: var(--muted);
	}

	.icon {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Show the icon for the theme you would switch to. */
	.sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: none;
		}
	}
</style>
