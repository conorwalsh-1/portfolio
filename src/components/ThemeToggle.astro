<!--
	The accessible name starts with the visible text ("theme dark") and adds the action for
	screen readers, so voice-control users can say what they see (WCAG 2.5.3 Label in Name).
-->
<button class="theme-toggle" type="button" data-theme-toggle>
	<!-- prettier-ignore -->
	<span aria-hidden="true">$</span> theme <span data-theme-label>auto</span><span class="visually-hidden" data-theme-action>(switch theme)</span>
</button>

<script>
	type Theme = 'light' | 'dark';

	const root = document.documentElement;
	const media = window.matchMedia('(prefers-color-scheme: dark)');

	function current(): Theme {
		const set = root.dataset.theme;
		if (set === 'light' || set === 'dark') return set;
		return media.matches ? 'dark' : 'light';
	}

	function render() {
		const theme = current();
		const next = theme === 'dark' ? 'light' : 'dark';
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			const label = button.querySelector('[data-theme-label]');
			if (label) label.textContent = theme;
			const action = button.querySelector('[data-theme-action]');
			if (action) action.textContent = ` (switch to ${next} theme)`;
		}
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => {
			const next: Theme = current() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				/* storage blocked: the choice lasts for this page view only */
			}
			render();
		});
	}

	media.addEventListener('change', render);
	render();
</script>

<style>
	.theme-toggle {
		font: inherit;
		font-size: 0.875rem;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.3rem 0.65rem;
		min-height: 2.25rem;
		cursor: pointer;
	}

	.theme-toggle:hover {
		border-color: var(--accent);
	}

	.theme-toggle span[aria-hidden] {
		color: var(--prompt);
	}
</style>
