---
import type { TimelineEntry } from '../data/profile';
import { byMostRecent, formatMonth, toDatetime } from '../utils/dates';

interface Props {
	entries: TimelineEntry[];
	label: string;
}

const { entries, label } = Astro.props;
---

<ol class="timeline" aria-label={label}>
	{
		byMostRecent(entries).map((entry) => (
			<li>
				<div class="head">
					<h4>
						{entry.title} <span class="at">@ {entry.org}</span>
					</h4>
					<p class="meta muted">
						<time datetime={toDatetime(entry.start)}>{formatMonth(entry.start)}</time> –{' '}
						{entry.end === 'present' ? <span>Present</span> : <time datetime={toDatetime(entry.end)}>{formatMonth(entry.end)}</time>}
						<span aria-hidden="true"> · </span>
						<span class="visually-hidden">, </span>
						{entry.location}
					</p>
				</div>
				{entry.points.length > 0 && (
					<ul>
						{entry.points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				)}
			</li>
		))
	}
</ol>

<style>
	.timeline {
		display: grid;
		gap: 1.75rem;
		border-left: 1px dashed var(--border);
		padding-left: 1.25rem;
	}

	.timeline > li {
		position: relative;
	}

	.timeline > li::before {
		content: '';
		position: absolute;
		left: calc(-1.25rem - 4px);
		top: 0.55em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	h4 {
		font-size: 1rem;
	}

	.at {
		color: var(--path);
		font-weight: 400;
	}

	.meta {
		font-size: 0.85rem;
		margin-bottom: 0.4rem;
	}

	ul li {
		position: relative;
		padding-left: 1.5ch;
		font-size: 0.925rem;
	}

	ul li::before {
		content: '-';
		position: absolute;
		left: 0;
		color: var(--muted);
	}
</style>
