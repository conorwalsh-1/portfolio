---
import type { TimelineEntry } from '../data/profile';
import { byMostRecent, formatMonth, toDatetime } from '../utils/dates';

interface Props {
	entries: TimelineEntry[];
	label: string;
}

const { entries, label } = Astro.props;
---

<ol class="timeline" aria-label={label}>
	{
		byMostRecent(entries).map((entry) => (
			<li class="entry">
				<p class="dates muted">
					<time datetime={toDatetime(entry.start)}>{formatMonth(entry.start)}</time>
					{' – '}
					{entry.end === 'present' ? (
						<span>Present</span>
					) : (
						<time datetime={toDatetime(entry.end)}>{formatMonth(entry.end)}</time>
					)}
				</p>
				<div class="details">
					<h3>{entry.title}</h3>
					<p class="org">
						{entry.org}
						<span class="muted">, {entry.location}</span>
					</p>
					{entry.points.length > 0 && (
						<ul class="points">
							{entry.points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
					)}
				</div>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		display: grid;
	}

	.entry {
		display: grid;
		gap: 0.35rem 2rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.entry:first-child {
		padding-top: 0;
	}

	.entry:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	@media (min-width: 44rem) {
		.entry {
			grid-template-columns: 11rem 1fr;
		}
	}

	.dates {
		font-size: 0.925rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.15rem;
	}

	h3 {
		font-size: 1.1rem;
		font-weight: 650;
	}

	.org {
		margin-bottom: 0.6rem;
	}
</style>
