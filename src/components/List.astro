---
/**
 * A quiet labelled list: a small heading, then rows of
 * "title ........ date" with one line of detail underneath.
 * Rows with a link highlight on hover and show an arrow.
 */
interface Row {
	title: string;
	detail?: string;
	date: string;
	href?: string;
}

interface Props {
	id: string;
	heading: string;
	rows: Row[];
	/** Position in the page, used to stagger the entrance animation. */
	order?: number;
}

const { id, heading, rows, order = 0 } = Astro.props;
---

<section class="list reveal" style={`--i: ${order}`} aria-labelledby={`${id}-heading`}>
	<h2 id={`${id}-heading`}>{heading}</h2>
	<ul>
		{
			rows.map((row) =>
				row.href ? (
					<li>
						<a class="row linked" href={row.href} target="_blank" rel="noopener noreferrer">
							<span class="top">
								<span class="title">
									{row.title}
									<span class="arrow" aria-hidden="true">
										↗
									</span>
									<span class="visually-hidden"> (opens in a new tab)</span>
								</span>
								<span class="date">{row.date}</span>
							</span>
							{row.detail && <span class="detail">{row.detail}</span>}
						</a>
					</li>
				) : (
					<li>
						<div class="row">
							<span class="top">
								<span class="title">{row.title}</span>
								<span class="date">{row.date}</span>
							</span>
							{row.detail && <span class="detail">{row.detail}</span>}
						</div>
					</li>
				),
			)
		}
	</ul>
</section>

<style>
	.list {
		margin-top: 3rem;
	}

	h2 {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--muted);
		margin-bottom: 0.6rem;
	}

	ul {
		display: grid;
		gap: 0.15rem;
		/* Let hover tiles bleed past the text column so the text itself stays aligned. */
		margin-inline: -0.75rem;
	}

	.row {
		display: block;
		padding: 0.55rem 0.75rem;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: background-color 150ms ease;
	}

	.linked:hover {
		background: var(--hover);
	}

	.top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.title {
		color: var(--text);
		font-weight: 500;
	}

	.linked .title {
		color: var(--accent);
	}

	.arrow {
		display: inline-block;
		margin-left: 0.2rem;
		opacity: 0;
		transform: translate(-3px, 2px);
		transition:
			opacity 150ms ease,
			transform 150ms ease;
	}

	.linked:hover .arrow,
	.linked:focus-visible .arrow {
		opacity: 1;
		transform: none;
	}

	.date {
		flex-shrink: 0;
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}

	.detail {
		display: block;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		margin-top: 0.15rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}
</style>
