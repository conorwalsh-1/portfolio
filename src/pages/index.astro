---
import List from '../components/List.astro';
import { education, profile, projects, work } from '../data/profile';
import Base from '../layouts/Base.astro';
import { byMostRecent, formatYears } from '../utils/dates';
import { mailto } from '../utils/links';

const description = `${profile.name}: software engineering student at the University of Limerick.`;

const external = { target: '_blank', rel: 'noopener noreferrer' } as const;

const rows = (roles: typeof work) =>
	byMostRecent(roles).map((role) => ({ title: role.title, detail: role.org, date: formatYears(role.start, role.end) }));
---

<Base title={profile.name} description={description}>
	<header class="intro">
		<h1>{profile.name}</h1>
		<p class="role">{profile.role}</p>
	</header>

	<div class="prose">
		<p>
			I’m in my first year of Immersive Software Engineering at the{' '}
			<a href={profile.school.href} {...external}>{profile.school.name}</a>. Before that I spent most of my time on maths
			and physics, and finished the Leaving Cert with 613 points, including 600/600 in Higher Level Maths.
		</p>
		<p>
			Recently I built{' '}
			<a href="https://github.com/conorwalsh-1/cs4421-astro-blog" {...external}>Pianoforte</a>, a site about classical
			piano with a playable keyboard, tested and deployed to AWS automatically on every change. I also led a team of
			four on a Linux hardware inspector written in Java.
		</p>
		<p>
			I mostly write Java, Python and TypeScript, and have worked with Git, GitHub Actions, Docker and AWS. Outside of
			code I tutor Leaving Cert students in maths and physics, and I’m working towards Grade 8 piano.
		</p>
	</div>

	<List
		id="projects"
		heading="Projects"
		rows={projects.map((p) => ({ title: p.name, detail: p.blurb, date: p.year, href: p.href }))}
	/>

	<List id="work" heading="Work" rows={rows(work)} />

	<List id="education" heading="Education" rows={rows(education)} />

	<section class="contact" aria-labelledby="contact-heading">
		<h2 id="contact-heading">Contact</h2>
		<p>
			Email me at <a href={mailto(profile.email)}>{profile.email}</a>, or find me on{' '}
			<a href={profile.github.href} {...external}>{profile.github.label}</a> and{' '}
			<a href={profile.linkedin.href} {...external}>{profile.linkedin.label}</a>.
		</p>
	</section>
</Base>

<style>
	h1 {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text);
	}

	.role {
		color: var(--muted);
	}

	.prose {
		margin-top: 2.5rem;
		display: grid;
		gap: 1.1rem;
	}

	.contact {
		margin-top: 3rem;
	}

	.contact h2 {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--muted);
		margin-bottom: 1rem;
	}
</style>
