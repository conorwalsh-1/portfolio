---
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import { awards, education, experience, profile, projects, skills } from '../data/profile';
import Base from '../layouts/Base.astro';
import { linkAttrs, mailto } from '../utils/links';

const description = `${profile.name}: ${profile.role} in ${profile.location}. Projects, experience and skills.`;
---

<Base title={`${profile.name} · ${profile.role}`} description={description}>
	<section class="hero container" aria-labelledby="hero-heading">
		<div class="window">
			<div class="titlebar" aria-hidden="true">
				<span class="dots"><i></i><i></i><i></i></span>
				<span class="title">conor@portfolio: ~</span>
			</div>
			<div class="screen">
				<p class="line" aria-hidden="true"><span class="ps1">conor@portfolio:~$</span> whoami</p>
				<h1 id="hero-heading">{profile.name}</h1>
				<p class="role">{profile.role} <span class="muted">· {profile.location}</span></p>
				<p class="line" aria-hidden="true"><span class="ps1">conor@portfolio:~$</span> cat tagline.txt</p>
				<p class="tagline">{profile.tagline}</p>
				<p class="line" aria-hidden="true">
					<span class="ps1">conor@portfolio:~$</span> <span class="cursor"></span>
				</p>
				<ul class="cta">
					<li><a href="#projects" class="button primary">View projects</a></li>
					<li><a href={mailto(profile.email)} class="button">Get in touch</a></li>
				</ul>
			</div>
		</div>
	</section>

	<Section id="about" command="cat" label="about" suffix=".md">
		<div class="prose">
			{profile.about.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<h3 class="sub">Highlights</h3>
		<ul class="awards">
			{awards.map((award) => <li>{award}</li>)}
		</ul>
	</Section>

	<Section id="projects" command="ls ./" label="projects">
		<div class="grid">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</Section>

	<Section id="experience" command="cat" label="experience" suffix=".log">
		<div class="split">
			<div>
				<h3 class="sub">Work</h3>
				<Timeline entries={experience} label="Work experience" />
			</div>
			<div>
				<h3 class="sub">Education</h3>
				<Timeline entries={education} label="Education" />
			</div>
		</div>
	</Section>

	<Section id="skills" command="cat" label="skills" suffix=".json">
		<dl class="skills">
			{
				skills.map((group) => (
					<div class="skill-row">
						<dt>
							<span aria-hidden="true">"</span>
							{group.name}
							<span aria-hidden="true">":</span>
						</dt>
						<dd>
							<ul class="chips">
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</dd>
					</div>
				))
			}
		</dl>
	</Section>

	<Section id="contact" command="echo $" label="contact">
		<p class="prose">
			I'm open to internships, collaborations and a chat about software, maths or music. Email is the best way to reach
			me.
		</p>
		<ul class="contact">
			<li>
				<span class="key" aria-hidden="true">email</span>
				<a href={mailto(profile.email)}>{profile.email}</a>
			</li>
			{
				profile.links.map((link) => (
					<li>
						<span class="key" aria-hidden="true">
							{link.label.toLowerCase()}
						</span>
						<a {...linkAttrs(link.href)}>
							{link.href.replace(/^https:\/\/(www\.)?/, '')}
							<span class="visually-hidden">({link.label}, opens in a new tab)</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>
</Base>

<style>
	.hero {
		padding-top: clamp(2rem, 1rem + 5vw, 4.5rem);
	}

	.window {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) * 1.5);
		overflow: hidden;
		box-shadow: 0 12px 40px -24px rgb(0 0 0 / 0.5);
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.55rem 0.9rem;
		border-bottom: 1px solid var(--border);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.dots {
		display: inline-flex;
		gap: 6px;
	}

	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--border);
	}

	.screen {
		padding: clamp(1.25rem, 0.75rem + 2.5vw, 2.5rem);
		display: grid;
		gap: 0.5rem;
	}

	.line {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.line + :not(.line) {
		margin-top: -0.25rem;
	}

	.ps1 {
		color: var(--accent);
	}

	h1 {
		font-size: clamp(2rem, 1.2rem + 4.5vw, 3.75rem);
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.role {
		color: var(--path);
		margin-bottom: 1rem;
	}

	.tagline {
		max-width: var(--measure);
		margin-bottom: 1rem;
	}

	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.button {
		display: inline-block;
		padding: 0.55rem 1rem;
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 700;
	}

	.button.primary {
		background: var(--accent);
		color: var(--bg);
	}

	.button:hover {
		text-decoration: underline;
	}

	.prose {
		display: grid;
		gap: 1rem;
		max-width: var(--measure);
	}

	.sub {
		font-size: 1rem;
		color: var(--muted);
		margin: 2rem 0 1rem;
	}

	.sub::before {
		content: '## ';
		color: var(--prompt);
	}

	.split .sub {
		margin-top: 0;
	}

	.awards {
		display: grid;
		gap: 0.4rem;
		max-width: var(--measure);
	}

	.awards li {
		position: relative;
		padding-left: 2.5ch;
	}

	.awards li::before {
		content: '[*]';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-size: 0.7em;
		top: 0.35em;
	}

	.grid {
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	}

	.split {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
	}

	.skills {
		margin: 0;
		display: grid;
		gap: 0.9rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.skill-row {
		display: grid;
		gap: 0.4rem;
	}

	@media (min-width: 40rem) {
		.skill-row {
			grid-template-columns: 12ch 1fr;
			align-items: baseline;
		}
	}

	dt {
		color: var(--path);
	}

	dd {
		margin: 0;
	}

	.contact {
		display: grid;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	.contact li {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1ch;
	}

	.key {
		color: var(--prompt);
		min-width: 9ch;
	}

	.key::after {
		content: ':';
	}
</style>
