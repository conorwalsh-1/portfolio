---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Conor Walsh" description="This page does not exist.">
	<section class="container notfound" aria-labelledby="nf-heading">
		<p class="code">404</p>
		<h1 id="nf-heading">Page not found</h1>
		<p class="muted">Sorry, the page you were looking for doesn't exist or has moved.</p>
		<p><a class="button primary" href="/">Back to the home page</a></p>
	</section>
</Base>

<style>
	.notfound {
		padding-block: clamp(4rem, 3rem + 6vw, 8rem);
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.code {
		color: var(--accent);
		font-weight: 700;
	}

	h1 {
		font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
	}
</style>
